# syntax=docker/dockerfile:1
#
# Discord ボイスチャンネル常駐版（discord_voice_agent.py）実行用イメージ — ROCm / amdgpu
#   - STT(faster-whisper/CTranslate2) を Radeon（Strix Halo / gfx1151 等）で動かすため、
#     CTranslate2 公式の ROCm wheel（gfx1151 カーネル焼き込み済み）を使う。
#     コードは device="cuda" のままで動く（HIP が CUDA API を擬態する）。
#   - 音声 I/O は Discord 経由なので PulseAudio / ALSA の配管は不要
#     （libportaudio2 / libsndfile1 は voice_agent.py の import を通すためだけに入れる）。
#   - 実行には /dev/kfd・/dev/dri のマウントが必要（docker-compose.discord.yml 参照）。
#     ホスト側の amdgpu ドライバ導入は DISCORD.md を参照。
FROM ubuntu:24.04

# ROCm のユーザー空間バージョン（ホストのドライバと同系列にする）と
# CTranslate2 のリリースタグ。最新の組み合わせは
# https://github.com/OpenNMT/CTranslate2/releases を確認（v4.7.2 以降は ROCm 7.2.1 ビルド）。
ARG ROCM_VERSION=7.2.3
ARG CT2_VERSION=4.7.2

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# ── システム依存 ──
#   python3.12         : 実行ランタイム（CTranslate2 ROCm wheel が cp312 のため 3.12 必須）
#   libopus0           : discord.py の音声送受信（Opus エンコード/デコード）
#   libsndfile1        : soundfile
#   libportaudio2      : sounddevice の import を通すため（実際の再生はしない）
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv \
        libopus0 \
        libsndfile1 \
        libportaudio2 \
        ca-certificates wget gnupg unzip \
    && rm -rf /var/lib/apt/lists/*

# ── ROCm ユーザー空間（HIP ランタイム + rocBLAS/hipBLAS。フル `rocm` より小さい） ──
# カーネルドライバ(amdgpu)はホスト側のものを使う。コンテナにはライブラリだけ入れる。
RUN mkdir -p /etc/apt/keyrings \
    && wget -qO - https://repo.radeon.com/rocm/rocm.gpg.key \
        | gpg --dearmor > /etc/apt/keyrings/rocm.gpg \
    && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/rocm.gpg] https://repo.radeon.com/rocm/apt/${ROCM_VERSION} noble main" \
        > /etc/apt/sources.list.d/rocm.list \
    && printf 'Package: *\nPin: release o=repo.radeon.com\nPin-Priority: 600\n' \
        > /etc/apt/preferences.d/rocm-pin-600 \
    && apt-get update && apt-get install -y --no-install-recommends rocm-hip-libraries \
    && rm -rf /var/lib/apt/lists/*
ENV LD_LIBRARY_PATH=/opt/rocm/lib

WORKDIR /app

# ── Python 依存（Ubuntu 24.04 は PEP 668 のため venv に入れる） ──
# 依存リストは pyproject.toml の dependency group `discord`（PEP 735）で管理する。
#   1) CTranslate2 は PyPI 版（CUDA）ではなく、リリース添付の ROCm wheel を先に入れる。
#      group 内の faster-whisper の依存解決でも『既に入っている ctranslate2』が使われ、
#      上書きされない。
#   2) openwakeword は依存に tflite-runtime（Python 3.12 用 wheel が存在しない）を
#      宣言しており、group に入れると解決不能になるため --no-deps で別途入れる。
#      tflite は OWW_FRAMEWORK=onnx では実行時にも使われない（model.py 内の遅延
#      import のみ）。実行時に実際に使う依存は group 側に明示してある。
RUN python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
COPY pyproject.toml /app/pyproject.toml
RUN wget -q "https://github.com/OpenNMT/CTranslate2/releases/download/v${CT2_VERSION}/rocm-python-wheels-Linux.zip" \
    && unzip -j rocm-python-wheels-Linux.zip "*cp312*manylinux*x86_64.whl" -d /tmp/ct2 \
    && pip install --upgrade pip \
    && pip install /tmp/ct2/ctranslate2-*.whl \
    && pip install --group discord \
    && pip install --no-deps "openwakeword>=0.6.0" \
    && rm -rf rocm-python-wheels-Linux.zip /tmp/ct2

# ── openWakeWord 共有特徴モデルをビルド時に取得（初回起動の DL 待ちを無くす） ──
RUN python3 -c "import openwakeword.utils as u; u.download_models()"

# ── 実行に必要なコードを COPY ──
# config.py は env 駆動のローダ（秘密は持たない）。実値は .env から runtime 注入する。
# ウェイクワードモデルは compose で bind mount する。
COPY voice_agent.py /app/voice_agent.py
COPY discord_voice_agent.py /app/discord_voice_agent.py
COPY config.py /app/config.py

# WHISPER_DEVICE=cuda のままで ROCm(HIP) 上で動く。compose の environment で上書き可。
ENV WHISPER_DEVICE=cuda \
    OWW_MODEL_PATH=/app/zundamon.onnx \
    OWW_FRAMEWORK=onnx \
    VOICEVOX_URL=http://voicevox:50021 \
    HF_HOME=/cache/hf

CMD ["python3", "discord_voice_agent.py"]
