# 設定テンプレート。`cp .env.example .env` して、自分の環境に合わせて編集する。
# ここが唯一の編集面（config.py は触らない）。空 or 未記載の項目は config.py の既定値が使われる。
#
# 構成: ブラウザ（Web UI）でマイク録音・音声再生を行い、サーバ（FastAPI）が STT→LLM→TTS を
# オーケストレーションする。発話はプッシュトゥトーク（ボタン押下中/スペースキー）。
#
# 重要: 値の行末にコメント（# …）を書かないこと。.env ローダ（config.py）は行末コメントを
# 解釈せず値の一部として読み込むため、数値/真偽の項目が壊れて起動できなくなる。
# 説明は必ず値の「上の行」にコメントとして書く。

# ── Web サーバ（FastAPI / uvicorn） ──
# 0.0.0.0 で LAN からも到達可（公開時は TLS/認証を別途用意）
# SERVER_HOST=0.0.0.0
# ブラウザで http://localhost:8000 を開く
# SERVER_PORT=8000

# ── STT（faster-whisper） ──
WHISPER_MODEL=large-v3-turbo
# GPU が無い/不調なら cpu
WHISPER_DEVICE=cuda
# VRAM 節約は int8_float16
WHISPER_COMPUTE=float16
# WHISPER_LANGUAGE=ja
# 1=greedy（最速）
# WHISPER_BEAM_SIZE=1
# WHISPER_VAD_FILTER=false

# ── 会話 LLM（OpenAI 互換 / llama.cpp 等） ──
LLAMA_BASE_URL=http://127.0.0.1:8080/v1
# ★秘密。llama.cpp 側で --api-key 未設定なら何でも可
LLAMA_API_KEY=
LLAMA_MODEL=gemma
LLAMA_TEMPERATURE=0.7
LLAMA_MAX_TOKENS=512
# 会話履歴の上限（system 除く件数。20 ≒ 直近10往復）。0 で無制限。長時間会話の TTFT 悪化を防ぐ。
# LLAMA_MAX_HISTORY=20
# thinking(reasoning) 対応モデルでは思考トークンの分だけ初回の音出しが遅れるので切る。
# バックエンドが chat_template_kwargs 非対応でエラーになるときは false に。
LLAMA_DISABLE_THINKING=true
# 応答1文目の早出し（初回の音出しを縮める）。読点や文字数でも先に喋り出す。
# FIRST_FLUSH_MIN_CHARS: 読点で早出しする最小文字数（小さすぎると細切れ）
# FIRST_FLUSH_MIN_CHARS=12
# FIRST_FLUSH_MAX_CHARS: 区切りが来なくてもこの長さで区切って流す
# FIRST_FLUSH_MAX_CHARS=32
# TTFT/初音/合成の所要をログ表示
# TURN_TIMING=true
# STT 所要をログ表示
# STT_TIMING=true
# 起動時に Whisper/VOICEVOX/LLM を1回温め、初回の遅延を吸収
# WARMUP=true
# 人格を変えるなら（複数行はファイル指定が楽）:
# SYSTEM_PROMPT=あなたは…（1行で）
# SYSTEM_PROMPT_FILE=/app/system_prompt.txt

# ── Discord 会話ログ（任意） ──
# 会話ログ（あなたの発話 / AI の応答）を Discord Webhook へ投げ捨て式で送る。
# 同じチャンネルに Webhook を2本作り（名前・アイコンを「あなた」用と「VOICEVOXエージェント」用にする）、
# それぞれの URL を書くと投稿者が分かれて読みやすい。片方だけなら共用し発話者名を本文に前置。
# 両方空（未記載）なら機能オフ。★URL は秘密情報。この .env にだけ書く。
# DISCORD_WEBHOOK_URL_USER=https://discord.com/api/webhooks/...
# DISCORD_WEBHOOK_URL_AI=https://discord.com/api/webhooks/...

# ── ログモード（STT → Discord 直送・任意） ──
# Web UI の「ログモード」トグルを ON にすると、その発話を LLM・TTS を挟まず STT 結果のまま
# 下の Webhook へ送る（音声メモ・口述筆記用）。会話ログとは**別の Webhook** を使う
# （別チャンネルに作るのが楽）。未設定だとログモードは使えない。
# DISCORD_WEBHOOK_URL_LOGMODE=https://discord.com/api/webhooks/...

# ── opencode serve（作業エージェント） ──
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_PROVIDER_ID=llamacpp
OPENCODE_MODEL_ID=gemma

# ── 会話セッションの永続化 ──
# 会話履歴・表示ログ・opencode セッションを sid 単位でディスク保存し、再起動後も復元する。
# 既定は data/sessions（data/ は .gitignore 済み）。空文字でディスク保存を無効化（メモリのみ）。
# SESSION_STORE_DIR=

# ── TTS（VOICEVOX） ──
# docker では compose が VOICEVOX_URL=http://voicevox:50021 を注入する。
# ホスト直実行なら次行を有効化:
# VOICEVOX_URL=http://127.0.0.1:50021
# 既定の話者ID（Web UI では話者名で選べる。一覧は /speakers）
VOICEVOX_SPEAKER=3
VOICEVOX_SPEED=1.0
# 音量倍率（1.0 が標準。2.0 超は音割れに注意）
# VOICEVOX_VOLUME=1.5
