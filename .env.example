# 設定テンプレート。`cp .env.example .env` して、自分の環境に合わせて編集する。
# ここが唯一の編集面（config.py は触らない）。空 or 未記載の項目は config.py の既定値が使われる。

# ── ウェイクワード（openWakeWord） ──
# ホスト直実行時のモデルパス。docker では compose が /app/zundamon.onnx に上書きする。
OWW_MODEL_PATH=my_custom_model/zundamon.onnx
OWW_FRAMEWORK=onnx
OWW_THRESHOLD=0.5
# 誤発火対策（0 で無効）:
# OWW_VAD_THRESHOLD=0.5      # 内蔵 Silero VAD で「人の声」以外の発火を抑止（0.3〜0.7）
# WAKE_MIN_RMS=500           # 直近1秒の最大 RMS がこの値未満なら発火を無視（[wake] の rms= で調整）

# ── 録音 / VAD ──
# INPUT_DEVICE_INDEX=-1
SILENCE_RMS=500
SILENCE_HANG_SEC=0.6         # 発話終端の無音待ち。短いほど応答が速い／途中で切れやすい
# RMS_DEBUG=true             # 発話/無音の RMS 分布をログ表示（SILENCE_RMS の調整用）

# ── STT（faster-whisper） ──
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda          # GPU が無い/不調なら cpu
WHISPER_COMPUTE=float16      # VRAM 節約は int8_float16

# ── 会話 LLM（OpenAI 互換 / llama.cpp 等） ──
LLAMA_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_API_KEY=               # ★秘密。llama.cpp 側で --api-key 未設定なら何でも可
LLAMA_MODEL=gemma
LLAMA_TEMPERATURE=0.7
LLAMA_MAX_TOKENS=512
# 会話履歴の上限（system 除く件数。20 ≒ 直近10往復）。0 で無制限。長時間会話の TTFT 悪化を防ぐ。
# LLAMA_MAX_HISTORY=20
# thinking(reasoning) 対応モデルでは思考トークンの分だけ初回の音出しが遅れるので切る。
# バックエンドが chat_template_kwargs 非対応でエラーになるときは false に。
# LLAMA_DISABLE_THINKING=true
# 応答1文目の早出し（初回の音出しを縮める）。読点や文字数でも先に喋り出す。
# FIRST_FLUSH_MIN_CHARS=8     # 読点で早出しする最小文字数（小さすぎると細切れ）
# FIRST_FLUSH_MAX_CHARS=24    # 区切りが来なくてもこの長さで区切って流す
# TURN_TIMING=true            # TTFT/初音/合成の所要をログ表示
# WARMUP=true                 # 起動時に VOICEVOX/LLM を1回温め、初回の遅延を吸収
# 人格を変えるなら（複数行はファイル指定が楽）:
# SYSTEM_PROMPT=あなたは…（1行で）
# SYSTEM_PROMPT_FILE=/app/system_prompt.txt

# ── opencode serve（作業エージェント） ──
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_PROVIDER_ID=llamacpp
OPENCODE_MODEL_ID=gemma

# ── TTS（VOICEVOX） ──
# docker では compose が VOICEVOX_URL=http://voicevox:50021 を注入する。
# ホスト直実行なら次行を有効化:
# VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER=3           # 話者ID（/speakers で確認）
VOICEVOX_SPEED=1.0
# VOICEVOX_VOLUME=1.5        # 音量倍率（1.0 が標準。2.0 超は音割れに注意）

# ── 合図 / バージイン ──
ACK_MODE=voice               # voice / beep / both / off
ACK_VOICE_TEXT=はい
BARGE_IN_MODE=wakeword       # wakeword / energy / off
BARGE_IN_RMS=1200
BARGE_IN_MIN_SEC=0.25

# ── docker 用（コンテナからホストの PulseAudio へ） ──
# WSL2 + WSLg: compose が /mnt/wslg/PulseServer を同じパスでコンテナに mount する（既定）。
# Docker Desktop + Windows 版 PulseAudio(TCP) を使う場合は次を tcp:host.docker.internal:4713 にし、
# docker-compose.yml の socket マウント行を外す。
PULSE_SERVER=unix:/mnt/wslg/PulseServer
