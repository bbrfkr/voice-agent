# 設定テンプレート。`cp .env.example .env` して、自分の環境に合わせて編集する。
# ここが唯一の編集面（config.py は触らない）。空 or 未記載の項目は config.py の既定値が使われる。

# ── Discord ボイスチャンネル（音声 I/O） ──
# bot をボイスチャンネルに常駐させ、ウェイクワード無しでチャンネル内の発話に応答する。
# Discord Developer Portal で bot を作成し、対象サーバに招待（Connect / Speak 権限）。
# DISCORD_BOT_TOKEN        : bot トークン（★秘密。この .env にだけ書く）
# DISCORD_VOICE_CHANNEL_ID : 入室するボイスチャンネルの ID（チャンネル右クリック →「IDをコピー」）
# DISCORD_GUILD_ID         : 対象サーバ（ギルド）の ID（任意・将来用）
DISCORD_BOT_TOKEN=
DISCORD_VOICE_CHANNEL_ID=
# DISCORD_GUILD_ID=

# ── 発話区間（セグメンテーション） ──
# Discord は喋っている間だけ音声を送るため自前 VAD は不要。発話の終わりはパケット途切れで判定する。
# MIN_UTTERANCE_SEC=0.3      # これより短い発話は雑音として無視
# MAX_UTTERANCE_SEC=30.0     # 1発話の最大長（保険。超過分で区切る）

# ── STT（リモート・OpenAI 互換サーバ） ──
# faster-whisper を GPU サーバ側で OpenAI 互換サーバ（speaches / faster-whisper-server 等）として
# 動かし、bot は HTTP で叩くだけ（bot 側に GPU/CUDA は不要）。docker compose では stt サービスを使う。
# STT_BASE_URL=http://127.0.0.1:8000/v1     # 末尾に /audio/transcriptions を付けて叩く
# STT_API_KEY=                              # ★秘密。認証が要るサーバなら設定
STT_MODEL=Systran/faster-whisper-large-v3   # サーバ側で読み込むモデル名
# WHISPER_LANGUAGE=ja

# ── 会話 LLM（OpenAI 互換 / llama.cpp 等） ──
LLAMA_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_API_KEY=               # ★秘密。llama.cpp 側で --api-key 未設定なら何でも可
LLAMA_MODEL=gemma
LLAMA_TEMPERATURE=0.7
LLAMA_MAX_TOKENS=512
# 会話履歴の上限（system 除く件数。20 ≒ 直近10往復）。0 で無制限。長時間会話の TTFT 悪化を防ぐ。
# LLAMA_MAX_HISTORY=20
# thinking(reasoning) 対応モデルでは思考トークンの分だけ初回の音出しが遅れるので切る。
# バックエンドが chat_template_kwargs 非対応でエラーになるときは false に。
# LLAMA_DISABLE_THINKING=true
# 応答1文目の早出し（初回の音出しを縮める）。読点や文字数でも先に喋り出す。
# FIRST_FLUSH_MIN_CHARS=8     # 読点で早出しする最小文字数（小さすぎると細切れ）
# FIRST_FLUSH_MAX_CHARS=24    # 区切りが来なくてもこの長さで区切って流す
# TURN_TIMING=true            # TTFT/初音/合成の所要をログ表示
# WARMUP=true                 # 起動時に VOICEVOX/LLM を1回温め、初回の遅延を吸収
# 人格を変えるなら（複数行はファイル指定が楽）:
# SYSTEM_PROMPT=あなたは…（1行で）
# SYSTEM_PROMPT_FILE=/app/system_prompt.txt

# ── Discord 会話ログ（任意） ──
# 会話ログ（あなたの発話 / AI の応答）を Discord Webhook へ投げ捨て式で送る（テキストチャンネル）。
# 同じチャンネルに Webhook を2本作り（名前・アイコンを「あなた」用と「ずんだもん」用にする）、
# それぞれの URL を書くと投稿者が分かれて読みやすい。片方だけなら共用し発話者名を本文に前置。
# 両方空（未記載）なら機能オフ。★URL は秘密情報。この .env にだけ書く。
# DISCORD_WEBHOOK_URL_USER=https://discord.com/api/webhooks/...
# DISCORD_WEBHOOK_URL_AI=https://discord.com/api/webhooks/...

# ── ログモード（STT → Discord 直送・任意） ──
# 「ログモード」と発話すると ON。以降は LLM・TTS を挟まず STT 結果のまま下の Webhook へ送る
# （音声メモ・口述筆記用）。OFF は「ログモード終了」。発話全体が同義語に一致したときだけ切替。
# 会話ログとは**別の Webhook** を使う（別チャンネルに作るのが楽）。未設定なら ON にできない。
# DISCORD_WEBHOOK_URL_LOGMODE=https://discord.com/api/webhooks/...
# 切替コマンドの同義語を変えたいとき（カンマ区切り。空白・句読点・かなの表記ゆれは自動吸収）:
# LOG_MODE_ON_COMMANDS=ログモード,ログモード開始,ログモードオン
# LOG_MODE_OFF_COMMANDS=ログモード終了,ログモードオフ,ログモード解除

# ── opencode serve（作業エージェント） ──
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_PROVIDER_ID=llamacpp
OPENCODE_MODEL_ID=gemma

# ── TTS（VOICEVOX） ──
# docker compose では compose が VOICEVOX_URL=http://voicevox:50021 を注入する。
# bot を別ホストで動かす場合は次行をリモートのアドレスに:
# VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER=3           # 話者ID（/speakers で確認）
VOICEVOX_SPEED=1.0
# VOICEVOX_VOLUME=1.5        # 音量倍率（1.0 が標準。2.0 超は音割れに注意）

# ── バージイン（応答再生中の割り込み） ──
# 再生中にユーザーが話し始めたら再生を止めて聞き直す。Discord はパケット到来＝発話開始。
# BARGE_IN_ENABLED=true      # false で割り込み無効
# BARGE_IN_MIN_SEC=0.2       # この秒数以上喋り続けたら割り込み確定（短い物音での誤割り込み防止）
