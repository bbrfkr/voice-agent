# 秘密情報・ローカル設定（コミットしない）
# config.py は env 駆動ローダ（秘密なし）なのでコミット対象。実値は .env にだけ置く。
.env

# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Windows のダウンロード由来メタ（.Zone.Identifier / :Zone.Identifier 両方）
*Zone.Identifier

# ── 学習用の巨大データ / 生成物・学習済みモデル（再生成・再DL 可能なので追跡しない） ──
# DL したデータセット（RIR/ノイズ/特徴量, 数十GB）
data/
# VOICEVOX で生成した正例サンプル
wake_samples/
# 学習中間物は除外しつつ、学習成果のモデル（小さい）はコミットして保持する。
# zundamon.onnx は「現在使う方のコピー」（compose のマウント先）なので除外のまま。
#   zundamon_local.onnx   = ローカルマイク（PulseAudio/Windows 収録）環境向け
#   zundamon_discord.onnx = Discord ボイスチャンネル環境向け（実 Discord 収録データ入り）
my_custom_model/*
!my_custom_model/zundamon_local.onnx
!my_custom_model/zundamon_discord.onnx

# 手順1で各自 git clone する外部リポジトリ（学習コード入りソース版 openwakeword）
openWakeWord/

# faster-whisper(HuggingFace) の DL キャッシュ（compose が bind mount。数GB・再DL 可能）
.cache/
